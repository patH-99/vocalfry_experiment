  <Flow>
    <Routine name="welcomeRoutine"/>
    <LoopInitiator loopType="TrialHandler" name="introLoop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'introFile': 'introductory_stimuli/creak_f_1.wav', 'introText': 'This is an example of vocal fry. (1 of 6)'}, {'introFile': 'introductory_stimuli/creak_m_1.wav', 'introText': 'This is another example of vocal fry. (2 of 6)'}, {'introFile': 'introductory_stimuli/creak_f_2.wav', 'introText': 'This is another example of vocal fry. (3 of 6)'}, {'introFile': 'introductory_stimuli/creak_m_2.wav', 'introText': 'This is another example of vocal fry. (4 of 6)'}, {'introFile': 'introductory_stimuli/creak_f_3.wav', 'introText': 'This is another example of vocal fry. (5 of 6)'}, {'introFile': 'introductory_stimuli/creak_m_3.wav', 'introText': 'This is the last example of vocal fry. (6 of 6)'}]" valType="str"/>
