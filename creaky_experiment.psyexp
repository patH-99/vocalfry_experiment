    </LoopInitiator>
    <Routine name="mainTrial"/>
    <Routine name="breakScreen"/>
    <LoopTerminator name="mainLoop"/>
    <Routine name="mainFinished"/>
    <LoopInitiator loopType="TrialHandler" name="surveyLoop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'qid': 'age', 'qtext': 'What is your age?', 'qtype': 'text', 'required': 1}, {'qid': 'native_language', 'qtext': 'What is your native language?', 'qtype': 'text', 'required': 1}, {'qid': 'hearing_difficulty', 'qtext': 'Do you have any hearing difficulties?', 'qtype': 'choice', 'required': 1}, {'qid': 'profession', 'qtext': 'Do you work with speech or the voice in your daily life (eg., as a speech scientist/pathologist/voice coach)?', 'qtype': 'choice', 'required': 1}, {'qid': 'vf_knowledge', 'qtext': 'Did you know about vocal fry before the experiment?', 'qtype': 'choice', 'required': 1}, {'qid': 'synthesis_validity', 'qtext': 'Did the synthesized voices sound natural to you?', 'qtype': 'choice', 'required': 1}, {'qid': 'comments', 'qtext': 'Do you have any comments about the experiment? (optional)', 'qtype': 'text', 'required': 0}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions/survey_items.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0,1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
