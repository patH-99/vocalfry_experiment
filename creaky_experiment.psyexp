      <CodeComponent name="surveyQLogic" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="is_text_type = (qtype === &quot;text&quot;);&amp;#10;selected_choice = &quot;&quot;;&amp;#10;prevYesState = false;&amp;#10;prevNoState = false;&amp;#10;prevContinueState = false;&amp;#10;textAnswerBox.reset();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="is_text_type = (qtype == 'text')&amp;#10;selected_choice = ''&amp;#10;prevYesState = False&amp;#10;prevNoState = False&amp;#10;prevContinueState = False&amp;#10;textAnswerBox.reset()" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="# Show only the relevant input widget&amp;#10;textAnswerBox.opacity = 1.0 if is_text_type else 0.0&amp;#10;yesButton.opacity = 0.0 if is_text_type else (1.0 if selected_choice != 'Yes' else 0.6)&amp;#10;noButton.opacity = 0.0 if is_text_type else (1.0 if selected_choice != 'No' else 0.6)&amp;#10;&amp;#10;# Choice buttons (only meaningful when not text type)&amp;#10;yes_click_now = yesButton.isClicked&amp;#10;no_click_now = noButton.isClicked&amp;#10;if not is_text_type:&amp;#10;    if yes_click_now and not prevYesState:&amp;#10;        selected_choice = 'Yes'&amp;#10;    if no_click_now and not prevNoState:&amp;#10;        selected_choice = 'No'&amp;#10;prevYesState = yes_click_now&amp;#10;prevNoState = no_click_now&amp;#10;&amp;#10;# Determine current answer + whether it satisfies &quot;answered&quot;&amp;#10;if is_text_type:&amp;#10;    current_answer = textAnswerBox.text&amp;#10;    answered = True if current_answer.strip() else False&amp;#10;else:&amp;#10;    current_answer = selected_choice&amp;#10;    answered = True if selected_choice else False&amp;#10;&amp;#10;is_required = (required != 0)&amp;#10;&amp;#10;# Continue button&amp;#10;continue_click_now = surveyContinueBtn.isClicked&amp;#10;surveyContinueBtn.opacity = 1.0 if (answered or not is_required) else 0.35&amp;#10;if continue_click_now and not prevContinueState and (answered or not is_required):&amp;#10;    thisExp.addData('survey_' + qid, current_answer)&amp;#10;    continueRoutine = False&amp;#10;prevContinueState = continue_click_now" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="textAnswerBox.opacity = is_text_type ? 1.0 : 0.0;&amp;#10;yesButton.opacity = is_text_type ? 0.0 : (selected_choice !== 'Yes' ? 1.0 : 0.6);&amp;#10;noButton.opacity = is_text_type ? 0.0 : (selected_choice !== 'No' ? 1.0 : 0.6);&amp;#10;yesButton.fillColor = (selected_choice === 'Yes') ? 'green' : 'darkgrey';&amp;#10;noButton.fillColor = (selected_choice === 'No') ? 'green' : 'darkgrey';&amp;#10;yes_click_now = yesButton.isClicked;&amp;#10;no_click_now = noButton.isClicked;&amp;#10;if (!is_text_type) {&amp;#10;    if (yes_click_now &amp;&amp; !prevYesState) {&amp;#10;        selected_choice = 'Yes';&amp;#10;    }&amp;#10;    if (no_click_now &amp;&amp; !prevNoState) {&amp;#10;        selected_choice = 'No';&amp;#10;    }&amp;#10;}&amp;#10;prevYesState = yes_click_now;&amp;#10;prevNoState = no_click_now;&amp;#10;if (is_text_type) {&amp;#10;    current_answer = textAnswerBox.text;&amp;#10;    answered = current_answer.trim() ? true : false;&amp;#10;} else {&amp;#10;    current_answer = selected_choice;&amp;#10;    answered = selected_choice ? true : false;&amp;#10;}&amp;#10;is_required = (required !== 0);&amp;#10;continue_click_now = surveyContinueBtn.isClicked;&amp;#10;surveyContinueBtn.opacity = (answered || !is_required) ? 1.0 : 0.35;&amp;#10;if (continue_click_now &amp;&amp; !prevContinueState &amp;&amp; (answered || !is_required)) {&amp;#10;    psychoJS.experiment.addData('survey_' + qid, current_answer);&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;prevContinueState = continue_click_now;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="surveyQLogic" valType="code" updates="None" name="name"/>
      </CodeComponent>
