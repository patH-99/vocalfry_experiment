      </RoutineSettingsComponent>
      <CodeComponent name="trainingLogic" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="replayHookedOn = null;&amp;#10;replayPending = false;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="correct = false;&amp;#10;selection = &quot;&quot;;&amp;#10;nPlays = 0;&amp;#10;autoPlayed = false;&amp;#10;feedbackMsg = &quot;&quot;;&amp;#10;arrowPos = (stimType === &quot;modal&quot;) ? [-0.55, -0.015] : [0.475, -0.015];&amp;#10;labelText = (stimType === &quot;modal&quot;) ? &quot;There is NO vocal fry at all.&quot; : &quot;There is VERY STRONG vocal fry.&quot;;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="correct = False&amp;#10;selection = ''&amp;#10;arrowPos = (-0.55, -0.015) if stimType == &quot;modal&quot; else (0.475, -0.015)&amp;#10;labelText = &quot;There is NO vocal fry at all.&quot; if stimType == &quot;modal&quot; else &quot;There is VERY STRONG vocal fry.&quot;&amp;#10;feedbackMsg = &quot;&quot;&amp;#10;replay_used = False&amp;#10;prevReplayStateTrain = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if binButton.isClicked:&amp;#10;    selection = 'bin'&amp;#10;    trainSlider.reset()&amp;#10;rating = trainSlider.getRating()&amp;#10;if rating:&amp;#10;    selection = 'slider'&amp;#10;if selection == 'bin':&amp;#10;    correct = (stimType == 'modal')&amp;#10;elif selection == 'slider':&amp;#10;    correct = (stimType == 'creaky' and rating &gt;= 90)&amp;#10;else:&amp;#10;    correct = False&amp;#10;if not selection:&amp;#10;    feedbackMsg = &quot;&quot;&amp;#10;elif correct:&amp;#10;    feedbackMsg = &quot;You may now continue to the next sound!&quot;&amp;#10;else:&amp;#10;    feedbackMsg = &quot;Try again.&quot;&amp;#10;feedbackText.color = 'green' if correct else 'red'&amp;#10;binButton.fillColor = 'green' if selection == 'bin' else 'darkgrey'&amp;#10;continueBtn_4.opacity = 1.0 if correct else 0.35&amp;#10;&amp;#10;replay_click_now = replayBtn_2.isClicked&amp;#10;if replay_click_now and not prevReplayStateTrain:&amp;#10;    trainSound.play()&amp;#10;prevReplayStateTrain = replay_click_now&amp;#10;&amp;#10;if continueBtn_4.isClicked and correct:&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (!autoPlayed &amp;&amp; t &gt;= 0.3) {&amp;#10;    trainSound.play();&amp;#10;    autoPlayed = true;&amp;#10;    nPlays += 1;&amp;#10;}&amp;#10;&amp;#10;// play the sound once per space press&amp;#10;if (key_space.getKeys({keyList: ['space'], waitRelease: false}).length &gt; 0) {&amp;#10;    trainSound.play();&amp;#10;    nPlays += 1;&amp;#10;}&amp;#10;&amp;#10;// response&amp;#10;if (binButton.isClicked) {&amp;#10;    selection = &quot;bin&quot;;&amp;#10;    trainSlider.reset();&amp;#10;}&amp;#10;rating = trainSlider.getRating();&amp;#10;if (rating !== undefined &amp;&amp; rating !== null) {&amp;#10;    selection = &quot;slider&quot;;&amp;#10;}&amp;#10;&amp;#10;// scoring&amp;#10;if (selection === &quot;bin&quot; &amp;&amp; nPlays &gt; 0) {&amp;#10;    correct = (stimType === &quot;modal&quot;);&amp;#10;} else if (selection === &quot;slider&quot; &amp;&amp; nPlays &gt; 0) {&amp;#10;    correct = ((stimType === &quot;creaky&quot;) &amp;&amp; (rating &gt;= 90));&amp;#10;} else {&amp;#10;    correct = false;&amp;#10;}&amp;#10;&amp;#10;// feedback&amp;#10;feedbackMsg = (!selection) ? &quot;&quot; : (correct ? &quot;You may now continue to the next syllable!&quot; : &quot;Play the syllable and try again.&quot;);&amp;#10;feedbackText.color = (correct ? &quot;green&quot; : &quot;red&quot;);&amp;#10;binButton.fillColor = ((selection === &quot;bin&quot;) ? &quot;green&quot; : &quot;darkgrey&quot;);&amp;#10;continueBtn_4.opacity = (correct ? 1.0 : 0.35);&amp;#10;&amp;#10;if (continueBtn_4.isClicked &amp;&amp; correct) {&amp;#10;    continueRoutine = false;&amp;#10;}" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="trainSound.stop();&amp;#10;psychoJS.experiment.addData('nPlays', nPlays);" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="trainingLogic" valType="code" updates="None" name="name"/>
      </CodeComponent>
