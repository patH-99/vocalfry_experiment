        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="mainTrial" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="mainLogic" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="trialCounter = 0&amp;#10;totalTrials = 88" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="trialCounter = 0;&amp;#10;totalTrials = 88;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="trialCounter += 1;&amp;#10;counterText = `${trialCounter} / ${totalTrials}`;&amp;#10;bin_selected = false;&amp;#10;rating = 0;&amp;#10;response_given = false;&amp;#10;rt_clock = new util.Clock();&amp;#10;&amp;#10;nPlays = 0;&amp;#10;maxPlays = 2;&amp;#10;replay_used = false;&amp;#10;autoPlayed = false;&amp;#10;&amp;#10;console.log('Trial file:', stimFile);" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="trialCounter += 1&amp;#10;counterText = f&quot;{trialCounter} / {totalTrials}&quot;&amp;#10;bin_selected = False&amp;#10;replay_used = False&amp;#10;rating = 0&amp;#10;response_given = False&amp;#10;rt_clock = core.Clock()&amp;#10;prevReplayStateMain = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# 1. Bin button click&amp;#10;if binButton_2.isClicked:&amp;#10;    bin_selected = True&amp;#10;    mainSlider.reset()&amp;#10;&amp;#10;# 2. Slider interaction overrides bin selection&amp;#10;slider_rating = mainSlider.getRating()&amp;#10;if slider_rating:&amp;#10;    bin_selected = False&amp;#10;&amp;#10;# 3. Work out the current rating and whether a response exists at all&amp;#10;if bin_selected:&amp;#10;    rating = 0&amp;#10;    response_given = True&amp;#10;elif slider_rating:&amp;#10;    rating = slider_rating&amp;#10;    response_given = True&amp;#10;else:&amp;#10;    response_given = False&amp;#10;&amp;#10;# 4. Visual feedback&amp;#10;binButton_2.fillColor = 'green' if bin_selected else 'darkgrey'&amp;#10;continueBtn_5.opacity = 1.0 if response_given else 0.35&amp;#10;replayBtn_3.opacity = 0.35 if replay_used else 1.0&amp;#10;&amp;#10;# 5. Replay -- only usable once&amp;#10;replay_click_now = replayBtn_3.isClicked&amp;#10;if not replay_used and replay_click_now and not prevReplayStateMain:&amp;#10;    mainSound.play()&amp;#10;    replay_used = True&amp;#10;prevReplayStateMain = replay_click_now&amp;#10;    &amp;#10;# 6. Continue -- ends routine and saves data, only once a response exists&amp;#10;if continueBtn_5.isClicked and response_given:&amp;#10;    thisExp.addData('rating', rating)&amp;#10;    thisExp.addData('rt_sec', round(rt_clock.getTime(), 4))&amp;#10;    thisExp.addData('replay_used', replay_used)&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (!autoPlayed &amp;&amp; t &gt;= 0.3) {&amp;#10;    mainSound.play();&amp;#10;    autoPlayed = true;&amp;#10;    nPlays += 1;&amp;#10;}&amp;#10;&amp;#10;// replay via SPACE, limited to one&amp;#10;if (nPlays &lt; maxPlays &amp;&amp; key_space_2.getKeys({keyList: ['space'], waitRelease: false}).length &gt; 0) {&amp;#10;    mainSound.play();&amp;#10;    nPlays += 1;&amp;#10;    replay_used = true;&amp;#10;}&amp;#10;&amp;#10;// response&amp;#10;if (binButton_2.isClicked) {&amp;#10;    bin_selected = true;&amp;#10;    mainSlider.reset();&amp;#10;}&amp;#10;slider_rating = mainSlider.getRating();&amp;#10;if (slider_rating !== undefined &amp;&amp; slider_rating !== null) {&amp;#10;    bin_selected = false;&amp;#10;}&amp;#10;&amp;#10;if (bin_selected &amp;&amp; nPlays &gt; 0) {&amp;#10;    rating = 0;&amp;#10;    response_given = true;&amp;#10;} else if (slider_rating !== undefined &amp;&amp; slider_rating !== null &amp;&amp; nPlays &gt; 0) {&amp;#10;    rating = slider_rating;&amp;#10;    response_given = true;&amp;#10;} else {&amp;#10;    response_given = false;&amp;#10;}&amp;#10;&amp;#10;binButton_2.fillColor = (bin_selected ? &quot;green&quot; : &quot;darkgrey&quot;);&amp;#10;continueBtn_5.opacity = (response_given ? 1.0 : 0.35);&amp;#10;&amp;#10;if (continueBtn_5.isClicked &amp;&amp; response_given) {&amp;#10;    psychoJS.experiment.addData(&quot;rating&quot;, rating);&amp;#10;    psychoJS.experiment.addData(&quot;rt_sec&quot;, util.round(rt_clock.getTime(), 4));&amp;#10;    psychoJS.experiment.addData(&quot;replay_used&quot;, replay_used);&amp;#10;    psychoJS.experiment.addData(&quot;nPlays&quot;, nPlays);&amp;#10;    continueRoutine = false;&amp;#10;}" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="mainSound.stop()" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="mainLogic" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <SoundComponent name="mainSound" plugin="None">
        <Param val="" valType="device" updates="None" name="deviceLabel"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
